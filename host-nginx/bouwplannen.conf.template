# Bouwplannen achter de nginx op de server (HTTPS + doorsturen naar de Docker-container).
#
# Wordt ingevuld door host-nginx/install.sh. Handmatig gebruiken kan ook: vervang
#   {{DOMAIN}}  door je domein, bijvoorbeeld bouwplannen.streve.nl
#   {{PORT}}    door WEB_PORT uit .env (standaard 8380)
# en zet het bestand in /etc/nginx/sites-available/ met een link in sites-enabled/.

upstream bouwplannen_web {
    server 127.0.0.1:{{PORT}};
    keepalive 8;
}

# HTTP → HTTPS. Certbot gebruikt poort 80 ook voor het verlengen van het certificaat.
server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # Op nginx 1.25.1+ mag je "http2" hier weghalen en "http2 on;" eronder zetten.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{DOMAIN}};

    ssl_certificate     {{CERT_DIR}}/fullchain.pem;
    ssl_certificate_key {{CERT_DIR}}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:bouwplannen_ssl:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Gelijk aan de limiet in de container (de API zelf accepteert 5 MB).
    client_max_body_size 6m;

    access_log /var/log/nginx/bouwplannen.access.log;
    error_log  /var/log/nginx/bouwplannen.error.log;

    location / {
        proxy_pass http://bouwplannen_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
