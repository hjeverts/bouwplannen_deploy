# Kopieer naar .env en vul in. .env staat niet in git.

# Sleutel die de app meestuurt. Maak er een met:  openssl rand -hex 24
BOUWPLANNEN_API_KEY=

# Poort op de server waar de website (app + /api) luistert. Kies een poort die nog vrij is
# (controleer met: ss -ltn); update.sh stopt met een melding als hij al bezet is.
# De nginx op je server stuurt je domein naar deze poort (zie host-nginx/).
WEB_PORT=8380
# 127.0.0.1 = alleen bereikbaar voor de reverse proxy op deze server (aanbevolen).
# 0.0.0.0   = ook direct bereikbaar vanaf het netwerk (zonder HTTPS; alleen binnen je eigen netwerk).
WEB_BIND=127.0.0.1

# Optioneel HTTPS via de meegeleverde Caddy, ALLEEN als er geen nginx of andere webserver op
# poort 80/443 draait (anders botsen ze; gebruik dan host-nginx/):
# COMPOSE_PROFILES=https
# DOMAIN=bouwplannen.jouwdomein.nl

# Broncode. SSH-adressen vragen een deploy key of SSH-sleutel op de server met leesrecht.
FRONTEND_REPO=git@github.com:hjeverts/bouwplannen_frontend.git
BACKEND_REPO=git@github.com:hjeverts/bouwplannen_backend.git
BRANCH=main

# Map met de projecten (JSON-bestanden), relatief aan bouwplannen_deploy. Standaard: bouwplannen/data
# BOUWPLANNEN_DATA_DIR=../data
# Gebruiker waarmee de API schrijft; update.sh vult dit in met de eigenaar van de datamap.
# BOUWPLANNEN_UID=1000
# BOUWPLANNEN_GID=1000

# Aantal back-ups van de projectdata dat bewaard blijft (één per update met wijzigingen).
BACKUP_KEEP=14
